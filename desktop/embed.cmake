# Compiles the hub's page (desktop/hub) into awdt: writes a header with the
# files' bytes. Usage: cmake -DDIR=<desktop/hub> -DOUT=<header> -P embed.cmake
set(FILES index.html app.js style.css)
set(content "// Generated by desktop/embed.cmake from desktop/hub: don't edit\n")
string(APPEND content "#pragma once\n#include <cstddef>\n\n")
string(APPEND content "struct HubFile {\n  const char* name;\n  const unsigned char* data;\n  size_t size;\n};\n\n")
set(table "")
foreach(name ${FILES})
  string(MAKE_C_IDENTIFIER "${name}" id)
  file(READ "${DIR}/${name}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND content "static const unsigned char kHub_${id}[] = {${bytes}};\n")
  string(APPEND table "    {\"${name}\", kHub_${id}, ${size}},\n")
endforeach()
string(APPEND content "\nstatic const HubFile kHubFiles[] = {\n${table}};\n")
file(WRITE "${OUT}" "${content}")
